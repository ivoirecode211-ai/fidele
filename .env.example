# Backend
# En production : DEBUG=False, une clé longue et aléatoire, et les adresses du serveur.
#   Clé : python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Production (HTTPS obligatoire, derrière Nginx ou Caddy) :
# ALLOWED_HOSTS=sante.mon-hopital.ci
# CORS_ALLOWED_ORIGINS=https://sante.mon-hopital.ci
# CSRF_TRUSTED_ORIGINS=https://sante.mon-hopital.ci
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# STATIC_ROOT=/var/www/ma-sante/static
# MEDIA_ROOT=/var/lib/ma-sante/media
# Notifications push de l'espace patient : contact affiché aux services de push.
# PUSH_CONTACT=mailto:contact@mon-hopital.ci

POSTGRES_DB=ma_sante
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Frontend
VITE_API_URL=http://127.0.0.1:8000/api
